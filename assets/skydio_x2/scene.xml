    <!-- Elevated Station Delta (Raised Hover Pedestal at x=8.0m: height 0.70m, top disc at z=0.70m) -->
    <geom name="pedestal_delta" type="cylinder" pos="8.0 0 0.35" size="0.45 0.35" rgba="0.22 0.25 0.28 1.0"/>
    <geom name="pedestal_delta_disc" type="cylinder" pos="8.0 0 0.705" size="0.45 0.005" rgba="1.0 0.9 0.1 0.95" contype="0" conaffinity="0"/>
