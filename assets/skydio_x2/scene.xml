<mujoco model="Skydio X2 scene">
  <include file="x2.xml"/>

  <statistic meansize=".05"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-20" elevation="-20" ellipsoidinertia="true"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.0" dir="0 0 -1" directional="true"/>
    <light pos="6.0 0 4.0" dir="-0.2 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Corridor Hazard Pylons (Gate Obstacles framing corridor at x=3.5m, giving 2+ sec System-2 reaction time) -->
    <geom name="pylon_left" type="cylinder" pos="3.5 0.9 0.4" size="0.09 0.4" rgba="0.9 0.2 0.2 0.95"/>
    <geom name="pylon_left_band1" type="cylinder" pos="3.5 0.9 0.5" size="0.093 0.06" rgba="1.0 0.85 0.0 1.0" contype="0" conaffinity="0"/>
    <geom name="pylon_left_band2" type="cylinder" pos="3.5 0.9 0.25" size="0.093 0.06" rgba="1.0 0.85 0.0 1.0" contype="0" conaffinity="0"/>

    <geom name="pylon_right" type="cylinder" pos="3.5 -0.9 0.4" size="0.09 0.4" rgba="0.9 0.2 0.2 0.95"/>
    <geom name="pylon_right_band1" type="cylinder" pos="3.5 -0.9 0.5" size="0.093 0.06" rgba="1.0 0.85 0.0 1.0" contype="0" conaffinity="0"/>
    <geom name="pylon_right_band2" type="cylinder" pos="3.5 -0.9 0.25" size="0.093 0.06" rgba="1.0 0.85 0.0 1.0" contype="0" conaffinity="0"/>

    <!-- Target Pad Alpha (Primary Front Landing Pad at x=5.5m: Safety Orange / Amber theme) -->
    <geom name="pad_alpha_base" type="cylinder" size="0.60 0.002" pos="5.5 0 0.002" rgba="1.0 0.35 0.0 0.85" contype="0" conaffinity="0"/>
    <geom name="pad_alpha_outer" type="cylinder" size="0.40 0.003" pos="5.5 0 0.003" rgba="1.0 0.85 0.0 0.9" contype="0" conaffinity="0"/>
