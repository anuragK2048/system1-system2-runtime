    <!-- Target Pad Bravo (Forward Left Waypoint Pad at x=11.0m, y=2.2m: Cyan / Neon Blue theme) -->
    <geom name="pad_bravo_base" type="cylinder" size="0.60 0.002" pos="11.0 2.2 0.002" rgba="0.0 0.7 0.9 0.85" contype="0" conaffinity="0"/>
