<mujoco model="Skydio X2 Dual Drone Comparison Scene">
  <compiler autolimits="true" assetdir="assets"/>

  <option timestep="0.002" density="1.225" viscosity="1.8e-5"/>

  <statistic meansize=".05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-20" elevation="-20" ellipsoidinertia="true"/>
  </visual>

  <default>
    <default class="x2">
      <geom mass="0"/>
      <motor ctrlrange="0 13"/>
      <mesh scale="0.01 0.01 0.01"/>
      <default class="visual">
        <geom group="2" type="mesh" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom group="3" type="box"/>
        <default class="rotor">
          <geom type="ellipsoid" size=".13 .13 .01"/>
        </default>
      </default>
      <site group="5"/>
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <texture type="2d" file="X2_lowpoly_texture_SpinningProps_1024.png"/>
    <material name="phong3SG" texture="X2_lowpoly_texture_SpinningProps_1024"/>
    <material name="invisible" rgba="0 0 0 0"/>

    <mesh class="x2" file="X2_lowpoly.obj"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.0" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Central Camera Anchor between both drones -->
    <body name="camera_anchor" pos="0 0 1.0">
      <camera name="dual_track" pos="-3.4 0 1.2" xyaxes="0 -1 0 0.35 0 1" mode="track"/>
    </body>

    <!-- =================================================================== -->
    <!-- DRONE 1 (SCREEN RIGHT, Spawn Y = -1.2m) - ORANGE/RED ACCENTS         -->
    <!-- =================================================================== -->
    <light name="spotlight1" mode="targetbodycom" target="d1_x2" pos="0 -2.2 2"/>
    <body name="d1_x2" pos="0 -1.2 0.1" childclass="x2">
      <freejoint name="d1_root"/>
      <site name="d1_imu" pos="0 0 .02"/>
      <geom material="phong3SG" mesh="X2_lowpoly" class="visual" quat="0 0 1 1"/>
      <geom class="collision" size=".06 .027 .02" pos=".04 0 .02"/>
      <geom class="collision" size=".06 .027 .02" pos=".04 0 .06"/>
      <geom class="collision" size=".05 .027 .02" pos="-.07 0 .065"/>
      <geom class="collision" size=".023 .017 .01" pos="-.137 .008 .065" quat="1 0 0 1"/>
      
      <!-- Distinct High-Visibility Orange Rotors for Drone 1 -->
      <geom name="d1_rotor1" class="rotor" pos="-.14 -.18 .05" mass=".25" rgba="1.0 0.35 0.10 0.75"/>
      <geom name="d1_rotor2" class="rotor" pos="-.14 .18 .05" mass=".25" rgba="1.0 0.35 0.10 0.75"/>
      <geom name="d1_rotor3" class="rotor" pos=".14 .18 .08" mass=".25" rgba="1.0 0.35 0.10 0.75"/>
      <geom name="d1_rotor4" class="rotor" pos=".14 -.18 .08" mass=".25" rgba="1.0 0.35 0.10 0.75"/>
      
      <!-- Visual Status Beacon Badge on top (Orange) -->
      <geom name="d1_beacon" type="cylinder" size="0.035 0.008" pos="0 0 0.075" rgba="1.0 0.30 0.0 1.0" contype="0" conaffinity="0"/>

      <geom size=".16 .04 .02" pos="0 0 0.02" type="ellipsoid" mass=".325" class="visual" material="invisible"/>
      
      <site name="d1_thrust1" pos="-.14 -.18 .05"/>
      <site name="d1_thrust2" pos="-.14 .18 .05"/>
      <site name="d1_thrust3" pos=".14 .18 .08"/>
      <site name="d1_thrust4" pos=".14 -.18 .08"/>
      
      <body name="d1_payload" pos="0.08 0.08 -0.02">
        <joint name="d1_swing_x" type="hinge" axis="1 0 0" damping="0.005"/>
        <joint name="d1_swing_y" type="hinge" axis="0 1 0" damping="0.005"/>
        <geom name="d1_tether_rod" type="cylinder" fromto="0 0 0 0 0 -0.22" size="0.003" mass="0.001" rgba="1 0.85 0.1 0" contype="0" conaffinity="0"/>
        <geom name="d1_payload_bob" type="sphere" pos="0 0 -0.22" size="0.038" mass="0.35" rgba="0.95 0.15 0.15 0" contype="0" conaffinity="0"/>
      </body>
    </body>

    <!-- =================================================================== -->
    <!-- DRONE 2 (SCREEN LEFT, Spawn Y = +1.2m) - CYAN/BLUE ACCENTS          -->
    <!-- =================================================================== -->
    <light name="spotlight2" mode="targetbodycom" target="d2_x2" pos="0 2.2 2"/>
    <body name="d2_x2" pos="0 1.2 0.1" childclass="x2">
      <freejoint name="d2_root"/>
      <site name="d2_imu" pos="0 0 .02"/>
      <geom material="phong3SG" mesh="X2_lowpoly" class="visual" quat="0 0 1 1"/>
      <geom class="collision" size=".06 .027 .02" pos=".04 0 .02"/>
      <geom class="collision" size=".06 .027 .02" pos=".04 0 .06"/>
      <geom class="collision" size=".05 .027 .02" pos="-.07 0 .065"/>
      <geom class="collision" size=".023 .017 .01" pos="-.137 .008 .065" quat="1 0 0 1"/>
      
      <!-- Distinct High-Visibility Cyan Rotors for Drone 2 -->
      <geom name="d2_rotor1" class="rotor" pos="-.14 -.18 .05" mass=".25" rgba="0.10 0.85 1.0 0.75"/>
      <geom name="d2_rotor2" class="rotor" pos="-.14 .18 .05" mass=".25" rgba="0.10 0.85 1.0 0.75"/>
      <geom name="d2_rotor3" class="rotor" pos=".14 .18 .08" mass=".25" rgba="0.10 0.85 1.0 0.75"/>
      <geom name="d2_rotor4" class="rotor" pos=".14 -.18 .08" mass=".25" rgba="0.10 0.85 1.0 0.75"/>
      
      <!-- Visual Status Beacon Badge on top (Cyan) -->
      <geom name="d2_beacon" type="cylinder" size="0.035 0.008" pos="0 0 0.075" rgba="0.0 0.90 1.0 1.0" contype="0" conaffinity="0"/>

      <geom size=".16 .04 .02" pos="0 0 0.02" type="ellipsoid" mass=".325" class="visual" material="invisible"/>
      
      <site name="d2_thrust1" pos="-.14 -.18 .05"/>
      <site name="d2_thrust2" pos="-.14 .18 .05"/>
      <site name="d2_thrust3" pos=".14 .18 .08"/>
      <site name="d2_thrust4" pos=".14 -.18 .08"/>
      
      <body name="d2_payload" pos="0.08 0.08 -0.02">
        <joint name="d2_swing_x" type="hinge" axis="1 0 0" damping="0.005"/>
        <joint name="d2_swing_y" type="hinge" axis="0 1 0" damping="0.005"/>
        <geom name="d2_tether_rod" type="cylinder" fromto="0 0 0 0 0 -0.22" size="0.003" mass="0.001" rgba="1 0.85 0.1 0" contype="0" conaffinity="0"/>
        <geom name="d2_payload_bob" type="sphere" pos="0 0 -0.22" size="0.038" mass="0.35" rgba="0.95 0.15 0.15 0" contype="0" conaffinity="0"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Drone 1 Actuators (indices 0..3) -->
    <motor class="x2" name="d1_thrust1" site="d1_thrust1" gear="0 0 1 0 0 -.0201"/>
    <motor class="x2" name="d1_thrust2" site="d1_thrust2" gear="0 0 1 0 0 .0201"/>
    <motor class="x2" name="d1_thrust3" site="d1_thrust3" gear="0 0 1 0 0 -.0201"/>
    <motor class="x2" name="d1_thrust4" site="d1_thrust4" gear="0 0 1 0 0 .0201"/>

    <!-- Drone 2 Actuators (indices 4..7) -->
    <motor class="x2" name="d2_thrust1" site="d2_thrust1" gear="0 0 1 0 0 -.0201"/>
    <motor class="x2" name="d2_thrust2" site="d2_thrust2" gear="0 0 1 0 0 .0201"/>
    <motor class="x2" name="d2_thrust3" site="d2_thrust3" gear="0 0 1 0 0 -.0201"/>
    <motor class="x2" name="d2_thrust4" site="d2_thrust4" gear="0 0 1 0 0 .0201"/>
  </actuator>

  <sensor>
    <!-- Drone 1 Sensors -->
    <gyro name="d1_body_gyro" site="d1_imu"/>
    <accelerometer name="d1_body_linacc" site="d1_imu"/>
    <framequat name="d1_body_quat" objtype="site" objname="d1_imu"/>

    <!-- Drone 2 Sensors -->
    <gyro name="d2_body_gyro" site="d2_imu"/>
    <accelerometer name="d2_body_linacc" site="d2_imu"/>
    <framequat name="d2_body_quat" objtype="site" objname="d2_imu"/>
  </sensor>

  <keyframe>
    <key name="hover"
         qpos="0 -1.2 0.3 1 0 0 0 0 0 0 1.2 0.3 1 0 0 0 0 0"
         ctrl="3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625 3.2495625"/>
  </keyframe>
</mujoco>